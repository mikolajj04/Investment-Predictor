@page "/DailyNews"
@using InvestmentPredictor.Core.Entities
@using Microsoft.EntityFrameworkCore
@using InvestmentCalculator.WebApp.Data
@using Markdig
@inject AppDbContext DbContext

<PageTitle>@(isEnglish ? "Daily Market AI Summary" : "Poranne Podsumowanie Rynku AI")</PageTitle>

<div class="container px-2 px-sm-3 mt-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="calc-title-clean">🤖 @(isEnglish ? "Daily AI Market Summary" : "Poranne podsumowanie AI")</h2>
            <p class="text-muted mb-0">
                @(isEnglish
                    ? "Synthetic analysis of global market sentiment and macroeconomic trends"
                    : "Syntetyczna analiza globalnego sentymentu rynkowego i makroekonomicznego")
            </p>
        </div>

        <div class="lang-switch shadow-sm @(isEnglish ? "en-active" : "pl-active")">
            <div class="lang-slider"></div>
            <button type="button" class="lang-btn @(!isEnglish ? "active" : "")" @onclick="() => isEnglish = false">
                 PL
            </button>
            <button type="button" class="lang-btn @(isEnglish ? "active" : "")" @onclick="() => isEnglish = true">
                 EN
            </button>
        </div>
    </div>

    

    @if (latestSnippet == null)
    {
        <div class="alert alert-warning shadow-sm border-0" role="alert">
            <h5 class="alert-heading">@(isEnglish ? "No data available!" : "Brak danych!")</h5>
            <p>
                @(isEnglish
                    ? "Loading latest data...."
                    : "Trwa ładowanie danych...")
            </p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 bg-light mt-3 mb-4">
            <div class="card-body px-3 py-3 p-sm-4">
                <div class="d-flex align-items-center mb-3">
                    <h5 class="card-title text-primary mb-0 glass-title-blue hide-on-micro">
             @(isEnglish ? "Wall Street Sentiment" : "Sentyment na Wall Street")
                    </h5>
                    <span class="badge bg-secondary ms-auto">
                        @latestSnippet.CreatedAt.ToLocalTime().ToString("g")
                    </span>
                </div>
                @if (latestSnippet?.SentimentScore.HasValue == true)
                {
                    var score = latestSnippet.SentimentScore.Value;
                    var (label, colorHex) = GetSentimentDetails(score, isEnglish);

                                <div class="sentiment-widget bg-light px-3 py-2 rounded border mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-uppercase  text-muted" style="font-size: 0.70rem; letter-spacing: 0.05em;  font-weight: 500;">
                                            @(isEnglish ? "Macro Sentiment Index" : "Wskaźnik Sentymentu Makro")
                                        </span>
                            <div class="d-flex align-items-center">
                                <span class="d-none d-md-inline me-2" style="color: @colorHex; font-size: 0.85rem; letter-spacing: 0.5px; text-transform: uppercase; font-weight: 500">
                                    @label
                                </span>
                                <span class="badge bg-white text-muted border shadow-sm px-2 py-1" style="font-size: 0.75rem; font-weight: 600;">
                                    @score <span class="opacity-50">/ 100</span>
                                </span>
                            </div>
                        </div>

                        <div class="sentiment-track position-relative my-2">
                            <div class="sentiment-bar"></div>
                            <div class="sentiment-marker" style="left: @(score)%;"></div>
                        </div>

                        <div class="d-flex justify-content-between text-muted" style="font-size: 0.65rem;">
                            <span>@(isEnglish ? "Fear" : "Strach")</span>
                            <span>@(isEnglish ? "Neutral" : "Neutralnie")</span>
                            <span>@(isEnglish ? "Greed" : "Chciwość")</span>
                        </div>
                    </div>
                }

                <hr class="my-3" />

                <div class="card-text mt-3" style="font-size: 1.1rem; line-height: 1.7;">
                    @((MarkupString)Markdown.ToHtml(GetActiveContent()))
                </div>
            </div>
        </div>


        <div class="text-muted text-center" style="font-size: 0.70rem; margin-top: 15px; margin-bottom: 30px;">
            @(isEnglish
               ? "* Data generated automatically by an AI model. This summary does not constitute investment advice."
               : "* Dane generowane automatycznie przez model AI. To podsumowanie nie stanowi porady inwestycyjnej.")
        </div>
    }
</div>

@code {
    private MarketSnippet? latestSnippet;
    private bool isEnglish = false;

    protected override async Task OnInitializedAsync()
    {
        latestSnippet = await DbContext.MarketSnippets
                                      .OrderByDescending(s => s.CreatedAt)
                                      .FirstOrDefaultAsync();
    }

    private string GetActiveContent()
    {
        if (latestSnippet == null) return string.Empty;

    
        if (isEnglish && !string.IsNullOrWhiteSpace(latestSnippet.ContentEn))
        {
            return latestSnippet.ContentEn;
        }

        return latestSnippet.Content;
    }
    private (string Label, string ColorHex) GetSentimentDetails(int score, bool english)
    {
        return score switch
        {
            <= 25 => (english ? "Fear" : "Strach", "#ff0400"),
            <= 45 => (english ? "Moderate Fear" : "Umiarkowany strach", "#ed6c2f"),
            <= 55 => (english ? "Neutral" : "Neutralnie", "#eab208"),
            <= 75 => (english ? "Moderate Greed" : "Umiarkowana chciwość", "#98ba2b"),
            _ => (english ? "Greed" : "Chciwość", "#00c947")
        };
    }
}