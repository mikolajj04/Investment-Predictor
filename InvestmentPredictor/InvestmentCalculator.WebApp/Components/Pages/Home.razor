@page "/"
@using InvestmentPredictor.Core
@inject ILogger<Home> Logger
@inject IInvestmentCalculator Calc
@inject IJSRuntime JSRuntime

<PageTitle>Investment Calculator</PageTitle>

<div class="container-xl mt-4 mb-5">
    <div class="calc-header-clean text-center mb-4">
        <h1 class="calc-title-clean">Investment Calculator</h1>
    </div>

    <div class="row g-4">
        
        
        <div class="col-lg-4">
            <div class="card calc-card-custom d-flex flex-column">
                <div class="mb-3">
                    <label class="form-label">Initial Investment</label>
                    <input type="number" class="form-control" placeholder="0.00" @bind="initialAmount" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Period (Years)</label>
                    <input type="number" class="form-control" @bind="period" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Monthly Subsidy</label>
                    <input type="number" class="form-control" placeholder="0.00" @bind="monthlySubsidy" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Choose your index</label>
                    <select class="form-select" @bind="chosenIndex">
                        @foreach (var index in Enum.GetValues<MarketIndex>())
                        {
                            if (index == MarketIndex.Custom)
                            {
                                <option value="@index">@index</option>
                            }
                            else
                            {
                                <option value="@index">@index - @Calc.GetIndexAnnualReturn(index).ToString("F1") %</option>
                            }
                        }
                    </select>

                    @if (chosenIndex == MarketIndex.Custom)
                    {
                        <div class="mt-3">
                            <label class="form-label">Enter your annual return (%)</label>
                            <input type="number" class="form-control" @bind="customRate" />
                        </div>
                    }
                </div>

                <div class="form-check form-switch my-3 d-flex align-items-center">
                    <input class="form-check-input" type="checkbox" id="tax" @bind="includeTax" />
                    <label class="form-check-label ms-2 fw-semibold text-secondary" style="font-size: 0.9rem;" for="tax">
                        Subtract 19% tax
                    </label>
                </div>

              
                <button class="btn calc-btn-action w-100 mt-auto" @onclick="Calculate">
                    <i class="bi bi-calculator me-2"></i>Calculate
                </button>

                @if (ErrorMessage != null)
                {
                    <div class="alert alert-danger text-center border-0 shadow-sm rounded-3 mt-3 mb-0">
                        @ErrorMessage
                    </div>
                }
            </div>
        </div>

       
        <div class="col-lg-8 d-flex flex-column" id="result-section">
            
            @if (finalResult > 0 && ErrorMessage == null)
            {
                <div class="row g-3 mb-4">
                    <!-- Kafel KPI 1: Wartość Portfela -->
                    <div class="col-md-6">
                        <div class="calc-result-box text-center h-100 d-flex flex-column justify-content-center p-4">
                            <div class="text-uppercase text-muted fw-bold" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                                Value of your investment
                            </div>
                            <div class="h2 fw-bolder text-dark my-2">
                                @finalResult.ToString("C")
                            </div>
                            @if (shouldShowTax)
                            {
                                <div class="text-danger fw-semibold" style="font-size: 0.85rem;">
                                    (Tax value: @taxValue.ToString("C"))
                                </div>
                            }
                        </div>
                    </div>
                    
                    <!-- Kafel KPI 2: Czysty Zysk -->
                    <div class="col-md-6">
                        <div class="calc-result-box text-center h-100 d-flex flex-column justify-content-center p-4" 
                             style="background: linear-gradient(180deg, #f0fdf4 0%, #dcfce7 100%); border-color: #bbf7d0;">
                            <div class="text-uppercase fw-bold" style="font-size: 0.8rem; letter-spacing: 0.05em; color: #166534;">
                                Pure Profit
                            </div>
                            <div class="h2 fw-bold text-success mt-2 mb-0">
                                @pureProfit.ToString("C")
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Wykres lub Placeholder -->
            <div class="card shadow-sm border-0 rounded-4 flex-grow-1 p-4" style="min-height: 450px;">
                @if (chartDatas.Any())
                {
                    <h5 class="mb-3 fw-bold text-secondary">Investment Growth</h5>
                    <ApexChart @ref="myChart" TItem="ChartData" Title="" Height="@("400")">
                        <ApexPointSeries TItem="ChartData"
                                        Items="chartDatas"
                                        Name="Portfolio Value"
                                        SeriesType="SeriesType.Area"
                                        XValue="@(e => e.Year)"
                                        YValue="@(e => e.Value)"
                                        Stroke="@(new SeriesStroke { Color = "#10b981", Width = 3 })" />
                    </ApexChart>
                }
                else
                {
                    <!-- Pusty stan widoczny przed obliczeniami -->
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center opacity-50">
                        <i class="bi bi-graph-up-arrow" style="font-size: 4rem; color: #cbd5e1;"></i>
                        <h4 class="mt-3 fw-bold" style="color: #94a3b8;">No data to display</h4>
                        <p class="text-muted" style="max-width: 300px;">Fill in the form on the left and click Calculate to simulate your investment trajectory.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@code {

	private ApexChart<ChartData>? myChart;
	private bool includeTax=false;
	private bool shouldShowTax = false;
	// private bool includeInflation = false; TO BE ADDED
	private decimal? initialAmount;
	private int period = 1;
	private decimal? monthlySubsidy;
	private MarketIndex chosenIndex = MarketIndex.SP500;
	private decimal? customRate;
	private decimal indexRate = 0;
	private decimal finalResult;
	private decimal pureProfit;
	private decimal taxValue;
	private string? ErrorMessage=null;
	private List<ChartData> chartDatas = new List<ChartData>();



	private async Task Calculate()
	{


		if (monthlySubsidy < 0 || period <= 0 || initialAmount < 0 || (chosenIndex == MarketIndex.Custom) && customRate < 0)
		{
			ErrorMessage = "Set proper parameters!";
			return;
		}
		else
		{
			ErrorMessage = null;
		}
		try
		{
			if (customRate == null)
			{
				indexRate = Calc.GetIndexAnnualReturn(chosenIndex);
			}
			else
			{
				indexRate = customRate.GetValueOrDefault();
			}

			var inputParams = new CalculatorParams(chosenIndex, monthlySubsidy.GetValueOrDefault(), initialAmount.GetValueOrDefault(), customRate.GetValueOrDefault(), indexRate, period);


			if (!includeTax)
			{
				finalResult = Calc.CalculateTotalValue(inputParams);
				shouldShowTax = false;
			}
			else
			{
				finalResult = Calc.TotalValueAfterTax(inputParams);
				shouldShowTax = true;
			}

			chartDatas = new List<ChartData>();
			var valueProjection = Calc.GetYearlyProjection(inputParams);
			for (int year = 0; year <= period; year++)
			{

				var value = valueProjection[year];


				if (year == period && includeTax)
				{

					value = finalResult;
				}


				var point = new ChartData
					{

						Year = year,
						Value = Math.Round(value, 2)


					};

				chartDatas.Add(point);





			}


			pureProfit = Calc.GetPureReturnValue(inputParams);
			taxValue = Calc.CalculateTaxValue(inputParams);
			if (myChart != null)
			{
				await myChart.UpdateSeriesAsync(true);
			}
			await Task.Delay(100);
			await JSRuntime.InvokeVoidAsync("scrollToElement", "result-section");

		}
		catch (Exception ex)
		{
			ErrorMessage = "A critical error occurred. Please refresh the page and try again.";
			Logger.LogCritical(ex, "CALCULATION_FATAL_ERROR: {Message}", ex.Message);
		}
	}

	public class ChartData
	{
		public int Year { get; set; }
		public decimal Value { get; set; }
	}

}