@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
       

        <article class="content px-4">
            @Body
        </article>
        <footer class="text-center py-2 mt-auto" style="font-size: 0.75rem; color: #6c757d; opacity: 0.4;">
            &copy; @DateTime.Now.Year MJ Invest Calc. Author: Mikołaj Jussak
        </footer>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
